# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environment
.venv/
venv/
env/

# uv lockfile — deliberately not committed: dependencies resolve to the latest
# matching versions at install time (same semantics as the old pip install)
uv.lock

# Generated at install time — run ./install.sh to create locally
run.sh
config.toml
NiceTransfer.app/

# Transfer data — never commit actual files
data/upload/*
data/download/*
data/share/*
data/trash/
!data/upload/.gitkeep
!data/download/.gitkeep
!data/share/.gitkeep

# Internal planning docs — kept locally, not published
MCP.md
PLATFORMS.md
llms-ai-integration.md
UV_MIGRATION_TASK.md

# Claude Code local dev config
.claude/

# NiceGUI runtime cache
.nicegui/

# NiceTransfer PID file (written at runtime)
.nicetransfer.pid

# macOS
.DS_Store
